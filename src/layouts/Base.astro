---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import { withBase } from '../lib/base.js';

const {
  title = 'Reflexiones — Biblioteca',
  description = 'Biblioteca de reflexiones pastorales del Pr. Walter Escalante.',
  ogImage = 'og-image.png',
  ogImageAlt = 'Reflexiones diarias por Walter Escalante — biblioteca pastoral',
  ogType = 'website',
  canonical = '/',
  article = null,
  jsonLd = null,
} = Astro.props;

const SITE_NAME = 'Reflexiones diarias — Pr. Walter Escalante';
const site = (Astro.site?.toString() || import.meta.env.SITE || '').replace(/\/$/, '');
const ogUrl = site ? `${site}${canonical}` : withBase(canonical);
const ogImg = site
  ? `${site}/${String(ogImage).replace(/^\//, '')}`
  : withBase(`/${String(ogImage).replace(/^\//, '')}`);
const ogImageExt = String(ogImage || '').split('.').pop()?.toLowerCase().split('?')[0];
const ogImageType =
  ogImageExt === 'webp' ? 'image/webp' : ogImageExt === 'jpg' || ogImageExt === 'jpeg' ? 'image/jpeg' : 'image/png';
// JSON-LD con URLs absolutas cuando hay site (prod); relativo en demo local.
const abs = (p) =>
  site ? `${site}/${String(p || '').replace(/^\//, '')}` : withBase(`/${String(p || '').replace(/^\//, '')}`);
const jsonLdResolved = jsonLd ? structuredClone(jsonLd) : null;
if (jsonLdResolved) {
  if (jsonLdResolved.image) jsonLdResolved.image = abs(jsonLdResolved.image);
  if (jsonLdResolved['@type'] === 'WebSite') jsonLdResolved.url = ogUrl;
  if (jsonLdResolved['@type'] === 'Article') {
    jsonLdResolved.mainEntityOfPage = ogUrl;
    if (jsonLdResolved.publisher && !jsonLdResolved.publisher.logo) {
      jsonLdResolved.publisher.logo = abs('imagenes/logos/logo-we.webp');
    }
  }
}
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase('/favicon-16x16.png')} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32x32.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <meta name="theme-color" content="#000000" />
    <meta name="author" content="Pr. Walter Escalante" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={ogUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImg} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content={ogUrl} />
    {ogType === 'article' && article?.publishedTime && (
      <meta property="article:published_time" content={article.publishedTime} />
    )}
    {ogType === 'article' && article?.modifiedTime && (
      <meta property="article:modified_time" content={article.modifiedTime} />
    )}
    {ogType === 'article' && article?.section && (
      <meta property="article:section" content={article.section} />
    )}
    {ogType === 'article' && article?.author && (
      <meta property="article:author" content={article.author} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImg} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {jsonLdResolved && <script type="application/ld+json" set:html={JSON.stringify(jsonLdResolved)} />}
    <ViewTransitions />
  </head>
  <body>
    <slot />
  </body>
</html>
